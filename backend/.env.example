# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection for the app (dev)
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot_dev_password@127.0.0.1:5432/careerpilot_dev

# Separate database used by the automated test suite (never your dev data)
TEST_DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot_dev_password@127.0.0.1:5432/careerpilot_test

# Logging
LOG_LEVEL=INFO

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Outbound HTTP (job source adapters)
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_MIN_REQUEST_INTERVAL_SECONDS=0.5

# Scheduler
DISCOVERY_SCHEDULER_ENABLED=true
DISCOVERY_INTERVAL_MINUTES=180

# AI answer drafts (Phase 2.2). Off by default. CareerPilot works without these.
# Never commit a real key. The frontend never receives GEMINI_API_KEY.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.4
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_RETRIES=2
